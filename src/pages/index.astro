---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
---

<Layout title="Lead Magnets">
  <div style="max-width: 1200px; margin: 0 auto; padding: 40px 20px;">
    <h1 style="margin-bottom: 10px;">Free Resources</h1>
    <p style="color: #666; margin-bottom: 40px; font-size: 18px;">Download guides, checklists, and cheatsheets</p>

    {resources.length === 0 ? (
      <div style="text-align: center; padding: 60px 20px; background: white; border-radius: 8px;">
        <p style="color: #999; font-size: 16px;">No resources available yet.</p>
      </div>
    ) : (
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
        {resources.map(resource => (
          <a
            href={`/${resource.slug}`}
            style={{
              display: 'block',
              padding: '24px',
              background: 'white',
              border-radius: '8px',
              text-decoration: 'none',
              color: 'inherit',
              border: '1px solid #e0e0e0',
              transition: 'all 0.2s ease',
            }}
            onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)'; this.style.borderColor='#ddd';"
            onmouseout="this.style.boxShadow='none'; this.style.borderColor='#e0e0e0';"
          >
            <h3 style="margin-bottom: 8px; font-size: 18px;">{resource.data.title}</h3>
            <p style="color: #666; font-size: 14px; margin-bottom: 12px;">{resource.data.subtitle}</p>
            <div style="font-size: 12px; color: #999;">{resource.data.pages} page{resource.data.pages !== 1 ? 's' : ''}</div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
